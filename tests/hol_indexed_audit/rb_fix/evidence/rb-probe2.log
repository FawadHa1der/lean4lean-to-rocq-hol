module Lean4hol :
  sig
    type name = Anonymous | Str of name * string | Num of name * string
    type level =
        Zero
      | Succ of level
      | Max of level * level
      | Imax of level * level
      | Param of name
    type expr =
        Bvar of int
      | Sort of level
      | Const of name * level list
      | App of expr * expr
      | Lam of name * expr * expr
      | Pi of name * expr * expr
      | Let of name * expr * expr * expr
      | Natlit of string
    type error_kind = Invalid_input | Unsupported | Resource | Proof_failure
    type error = { kind : error_kind; message : string; }
    exception Stop of error
    type budget = { mutable remaining : int; }
    val stop : error_kind -> string -> 'a
    val tick : budget -> unit
    val natural : string -> term
    val number : int -> term
    val node : string -> term list -> term
    val quote_name : name -> term
    val quote_level : level -> term
    val quote_expr : expr -> term
    val quote_context : expr list -> term
    val add : int -> int -> int
    val lift : budget -> int -> int -> expr -> expr
    val subst : budget -> int -> expr -> expr -> expr
    val instantiate_levels :
      budget -> name list -> level list -> expr -> expr
    val compute_object : conv
    val computation : conv
    val rules : thm array
    val level_proofs : (level * level, thm) Hashtbl.t
    val level_proof : budget -> level -> level -> thm
    module Engine :
      functor
        (Logic : sig
                   val rule : budget -> int -> term list -> thm list -> thm
                   val judgment : expr list -> expr -> expr -> expr -> term
                   val constant :
                     budget ->
                     expr list ->
                     name -> level list -> level list -> expr * thm
                   val delta :
                     budget ->
                     expr list ->
                     name -> level list -> (expr * expr * thm) option
                   val nat_literal :
                     budget -> expr list -> string -> expr * thm
                   val nat_literal_step :
                     budget -> expr list -> string -> expr * expr * thm
                   val iota :
                     budget ->
                     expr list ->
                     expr -> (expr * (expr -> thm -> thm -> thm)) option
                   val major : expr -> (expr * (expr -> expr)) option
                   val context_empty : thm
                   val context_extend : thm
                 end)
        ->
        sig
          val rule : budget -> int -> term list -> thm list -> thm
          val judgment : expr list -> expr -> expr -> expr -> term
          val guard : expr list -> expr -> expr -> expr -> thm -> thm
          val cache_budget : budget option ref
          val inference_cache : (expr list * expr, expr * thm) Hashtbl.t
          val reduction_cache :
            (expr list * expr, expr * expr * thm) Hashtbl.t
          val equality_cache :
            (expr list * expr * expr, expr * thm) Hashtbl.t
          val reset_caches : budget -> unit
          val infer_i : budget -> expr list -> expr -> expr * thm
          val infer_sort : budget -> expr list -> expr -> level * thm
          val sort_judgment :
            budget -> expr list -> expr * thm -> level * thm
          val pi_judgment :
            budget -> expr list -> expr * thm -> name * expr * expr * thm
          val convert_with :
            budget -> expr list -> expr -> expr -> expr * thm -> thm -> thm
          val cast : budget -> expr list -> expr * thm -> expr -> thm
          val check_i : budget -> expr list -> expr -> expr -> thm
          val sym : budget -> expr list -> expr -> expr -> expr -> thm -> thm
          val trans :
            budget ->
            expr list -> expr -> expr -> expr -> expr -> thm -> thm -> thm
          val whnf : budget -> expr list -> expr -> expr * expr * thm
          val equal_i : budget -> expr list -> expr -> expr -> expr * thm
          val equal_heads : budget -> expr list -> expr -> expr -> expr * thm
          val special_equal :
            budget -> expr list -> expr -> expr -> expr * thm
          val eta_equal : budget -> expr list -> expr -> expr -> expr * thm
          val context : budget -> expr list -> thm
        end
    module Pure :
      sig
        val rule : budget -> int -> term list -> thm list -> thm
        val judgment : expr list -> expr -> expr -> expr -> term
        val guard : expr list -> expr -> expr -> expr -> thm -> thm
        val cache_budget : budget option ref
        val inference_cache : (expr list * expr, expr * thm) Hashtbl.t
        val reduction_cache : (expr list * expr, expr * expr * thm) Hashtbl.t
        val equality_cache : (expr list * expr * expr, expr * thm) Hashtbl.t
        val reset_caches : budget -> unit
        val infer_i : budget -> expr list -> expr -> expr * thm
        val infer_sort : budget -> expr list -> expr -> level * thm
        val sort_judgment : budget -> expr list -> expr * thm -> level * thm
        val pi_judgment :
          budget -> expr list -> expr * thm -> name * expr * expr * thm
        val convert_with :
          budget -> expr list -> expr -> expr -> expr * thm -> thm -> thm
        val cast : budget -> expr list -> expr * thm -> expr -> thm
        val check_i : budget -> expr list -> expr -> expr -> thm
        val sym : budget -> expr list -> expr -> expr -> expr -> thm -> thm
        val trans :
          budget ->
          expr list -> expr -> expr -> expr -> expr -> thm -> thm -> thm
        val whnf : budget -> expr list -> expr -> expr * expr * thm
        val equal_i : budget -> expr list -> expr -> expr -> expr * thm
        val equal_heads : budget -> expr list -> expr -> expr -> expr * thm
        val special_equal : budget -> expr list -> expr -> expr -> expr * thm
        val eta_equal : budget -> expr list -> expr -> expr -> expr * thm
        val context : budget -> expr list -> thm
      end
    val rule : budget -> int -> term list -> thm list -> thm
    val judgment : expr list -> expr -> expr -> expr -> term
